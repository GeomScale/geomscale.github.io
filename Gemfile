source "https://rubygems.org"

# Build locally with:   bundle install && bundle exec jekyll serve
# The site is built and deployed by .github/workflows/pages.yml.

gem "jekyll", "~> 4.4"
gem "minimal-mistakes-jekyll", "~> 4.28"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-gist"
  gem "jekyll-include-cache"
  gem "jekyll-redirect-from"
  gem "jekyll-sitemap"
  gem "jekyll-titles-from-headings"
end

# Needed by `jekyll serve` on Ruby >= 3.0.
gem "webrick", "~> 1.8"
